{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cinema IPTV 2026",
  "version": "0.2.1",
  "identifier": "com.cinema.iptv2026",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cinema IPTV 2026",
        "width": 1400,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/mpv"],
    "category": "Entertainment",
    "shortDescription": "Fast and elegant IPTV player for Windows 11",
    "longDescription": "Cinema IPTV 2026 - A beautiful, fast IPTV player with Live TV, Movies, Series, EPG, favorites, and Xtream Codes support.",
    "copyright": "Copyright © 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": true
      }
    }
  }
}
